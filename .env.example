# Copy to .env (repository root for Docker Compose, or backend/.env for local runs).
# Never commit .env. Secrets are only read by the backend.

# ---- Telegram (optional; alerts are skipped when unset) ----
# Create a bot with @BotFather, send it a message, then read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Database ----
# Docker Compose sets DATABASE_URL for the backend from these values.
POSTGRES_USER=cryptosignal
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cryptosignal
# Local (non-Docker) runs: SQLite works out of the box; PostgreSQL is recommended:
# DATABASE_URL=postgresql+asyncpg://cryptosignal:change-me@localhost:5432/cryptosignal
# DATABASE_URL=sqlite+aiosqlite:///./cryptosignal.db

# ---- Frontend / CORS ----
# URL the browser uses to reach the backend (baked into the frontend build).
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# ---- Logging ----
LOG_LEVEL=INFO
LOG_JSON=true

# ---- Market data / scanner ----
DEFAULT_WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT
SCANNER_ENABLED=true
MARKET_STREAM_ENABLED=true
SCAN_INTERVAL_SECONDS=15
CANDLE_CLOSE_GRACE_SECONDS=3
STALE_AFTER_SECONDS=30
CANDLE_HISTORY_LIMIT=1000
BYBIT_REST_URL=https://api.bybit.com
BYBIT_WS_URL=wss://stream.bybit.com/v5/public/linear
BYBIT_MAX_REQUESTS_PER_SECOND=8
BACKTEST_TIMEOUT_SECONDS=600
